# ---- API (apps/api) ----
DATABASE_URL=postgres://tg:tg@localhost:5432/ticketghar
PORT=4000
PUBLIC_API_URL=http://localhost:4000      # public URL of this API; Khalti/eSewa redirect here
WEB_URL=http://localhost:3000             # customer web app
ADMIN_API_KEY=change-me                   # x-api-key for /admin endpoints
HOLD_MINUTES=10
ENABLE_MOCK_PAYMENTS=true                 # set false in production

# Khalti ePayment (sandbox: https://dev.khalti.com/api/v2, live: https://khalti.com/api/v2)
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=

# eSewa ePay v2 (test URLs shown; use production URLs and your merchant code live)
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=

# WhatsApp Cloud API (Meta). Leave token empty to log messages instead of sending.
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me

# ---- Web (apps/web) ----
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WHATSAPP_NUMBER=9779856023233
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true
